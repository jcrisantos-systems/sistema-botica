# Backups de base de datos: snapshots generados durante tareas de mantenimiento,
# no deben versionarse (pueden contener datos reales y crecen con cada backup).
*backup*.sql
bk_*.sql

# Archivos temporales del módulo de Importación Masiva (CSV subidos en proceso de
# validación; se borran solos al confirmar o cancelar, no deben versionarse)
storage/imports/*
!storage/imports/.gitkeep

# Archivos de sistema operativo / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
